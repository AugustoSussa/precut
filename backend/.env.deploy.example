# Preencher no painel Environment do Render, NUNCA versionar valores reais.
DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@HOST/BANCO
SECRET_KEY=GERAR_VALOR_ALEATORIO_MINIMO_32_CARACTERES
OPENAI_API_KEY=CHAVE_DA_API_OPENAI
OPENAI_MODEL=gpt-4o-mini
OPENAI_SEARCH_MODEL=gpt-4o
WHISPER_MODEL=tiny
MAX_UPLOAD_MB=150
# Na hospedagem paga, crie Disk com mount path /var/data
PRECUT_UPLOAD_DIR=/var/data/uploads
# Preencha depois de criar o endereco publico do frontend
FRONTEND_ORIGINS=https://SEU-FRONTEND.onrender.com
